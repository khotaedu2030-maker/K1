NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# مفتاح service_role — سيرفر فقط، ممنوع أي بادئة NEXT_PUBLIC، وممنوع الوصول له من المتصفح إطلاقًا.
SUPABASE_SERVICE_ROLE_KEY=

# Pilot Auth — بيئة تطوير فقط، لاختبار رحلة العميل بدون SMS/WhatsApp. يبقى مستحيل التفعيل في
# الإنتاج حتى لو ضُبط هذان المتغيران هناك بالخطأ، لأن الكود يتحقق أولًا من NODE_ENV != production.
# لا تضع قيمة حقيقية لـ KHOTA_PILOT_SECRET هنا — فقط في .env.local المحلي وغير المرفوع لأي مكان.
KHOTA_PILOT_AUTH=
KHOTA_PILOT_SECRET=

# تكامل الدفع الحقيقي (Paylink) — سيرفر فقط، لا قيم فعلية هنا إطلاقًا.
# PAYLINK_BASE_URL: بيئة الاختبار https://restpilot.paylink.sa، الإنتاج لاحقًا https://restapi.paylink.sa
PAYLINK_API_ID=
PAYLINK_API_SECRET=
PAYLINK_BASE_URL=
# سرّ التحقق من رأس Authorization الوارد من Paylink إلى Webhook — يُضبَط بنفس القيمة في لوحة Paylink.
PAYLINK_WEBHOOK_SECRET=

# النطاق الكامل للموقع (بلا شرطة مائلة أخيرة) — يُستخدَم لبناء callBackUrl/cancelUrl عند إنشاء
# فاتورة Paylink، مثل: https://www.khota.sa
NEXT_PUBLIC_SITE_URL=

# نموذج التواصل (/contact) — إشعار بريد اختياري فقط عبر Resend API بعد الحفظ في Supabase
# (مصدر الحقيقة). فشل هذا الإشعار لا يُفشِل حفظ الرسالة أبدًا.
RESEND_API_KEY=
# اختياري — عنوان "from" الظاهر للمستلم. يتطلب توثيق نطاق فعليًا لدى Resend لاستخدام دومين
# خُطى (مثل support@khota.sa). إن تُرك فارغًا، يُستخدَم عنوان Resend التجريبي للاختبار فقط.
CONTACT_FROM_EMAIL=
